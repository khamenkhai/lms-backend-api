// This is your Prisma schema file for NeonDB (PostgreSQL)
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserOTP {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("user_opts")
}

model User {
  id                    Int                   @id @default(autoincrement())
  name                  String
  email                 String                @unique
  password              String
  role                  UserRole              @default(student)
  enrollments           Enrollment[]
  userContentProgresses UserContentProgress[]
  reviews               Review[]
  userQuizAttempts      UserQuizAttempt[]
  // orders                Order[]
  courses               Course[]
  cart                  UserCart[]
  wish_lists            Wishlist[]
  certificates          Certificate[]
  moduleProgress        UserModuleProgress[]
  wallet                UserWallet?
  walletTransactions    WalletTransaction[]

  @@map("users")
}

enum UserRole {
  student
  instructor
  admin
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  courses     Course[]

  @@map("categories")
}

model Enrollment {
  id                  Int       @id @default(autoincrement())
  enrolled_at         DateTime  @default(now())
  completed_at        DateTime?
  access_expires_at   DateTime?
  user_id             Int
  course_id           Int
  user                User      @relation(fields: [user_id], references: [id])
  course              Course    @relation(fields: [course_id], references: [id])

  @@map("enrollments")
}

model UserCart {
  user_id   Int
  course_id Int
  added_at  DateTime @default(now())
  user      User     @relation(fields: [user_id], references: [id])
  course    Course   @relation(fields: [course_id], references: [id])

  @@id([user_id, course_id]) // composite PK
  @@map("user_carts")
}

model Course {
  id                Int           @id @default(autoincrement())
  title             String        @unique
  imageUrl          String?
  description       String?
  price             Int
  level             String
  language          String
  duration          String
  total_students    Int           @default(0)
  requirements      String
  learning_outcomes String
  category_id       Int
  category          Category      @relation(fields: [category_id], references: [id])
  modules           Module[]
  enrollments       Enrollment[]
  // orders            Order[]
  instructor_id     Int
  instructor        User          @relation(fields: [instructor_id], references: [id])
  user_cart         UserCart[]
  wish_list         Wishlist[]
  certificates      Certificate[]

  @@map("courses")
}

model Module {
  id                     Int                  @id @default(autoincrement())
  title                  String
  desription             String?
  position               Int
  course_id              Int
  course                 Course               @relation(fields: [course_id], references: [id])
  contents               Content[]
  user_module_progresses UserModuleProgress[]

  @@map("modules")
}

model Content {
  id                    Int                   @id @default(autoincrement())
  title                 String
  content_url           String //video, or image url
  content_type          ContentType
  duration              String
  position              Int
  module_id             Int
  module                Module                @relation(fields: [module_id], references: [id])
  userContentProgresses UserContentProgress[]
  reviews               Review[]
  quiz                  Quiz?

  @@map("contents")
}

model Quiz {
  id               Int               @id @default(autoincrement())
  title            String
  content_id       Int               @unique
  content          Content           @relation(fields: [content_id], references: [id])
  questions        Question[] // Remove onDelete from here
  userQuizAttempts UserQuizAttempt[]

  @@map("quizzes")
}

model Question {
  id              Int              @id @default(autoincrement())
  quiz_id         Int
  question_text   String
  type            QuizzAnswerType?
  quiz            Quiz             @relation(fields: [quiz_id], references: [id], onDelete: Cascade) // Add onDelete here
  answers         QuizzAnswer[]
  userQuizAnswers UserQuizAnswer[]

  @@map("quizz_questions")
}

model QuizzAnswer {
  id              Int              @id @default(autoincrement())
  answer_text     String
  question_id     Int
  is_correct      Boolean          @default(false)
  question        Question         @relation(fields: [question_id], references: [id], onDelete: Cascade) // Add onDelete here
  userQuizAnswers UserQuizAnswer[]

  @@map("quizz_answers")
}

enum QuizzAnswerType {
  TEXT
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model UserContentProgress {
  user_id      Int
  content_id   Int
  is_completed Boolean @default(false)
  user         User    @relation(fields: [user_id], references: [id])
  content      Content @relation(fields: [content_id], references: [id])

  @@id([user_id, content_id]) // composite PK
  @@map("content_progresses")
}

model Review {
  id           Int     @id @default(autoincrement())
  is_completed Boolean @default(false)
  user_id      Int
  user         User    @relation(fields: [user_id], references: [id])
  content_id   Int
  content      Content @relation(fields: [content_id], references: [id])

  @@map("reviews")
}

model UserQuizAttempt {
  id           Int               @id @default(autoincrement())
  user_id      Int
  quiz_id      Int
  started_at   DateTime          @default(now())
  completed_at DateTime?
  score        Decimal           @default(0)
  status       QuizAttemptStatus @default(IN_PROGRESS)
  user         User              @relation(fields: [user_id], references: [id])
  quiz         Quiz              @relation(fields: [quiz_id], references: [id])
  answers      UserQuizAnswer[]

  @@index([user_id])
  @@index([quiz_id])
  @@map("user_quiz_attempts")
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model UserQuizAnswer {
  id          Int             @id @default(autoincrement())
  attempt_id  Int
  question_id Int
  answer_id   Int? // nullable if no answer selected
  is_correct  Boolean
  answered_at DateTime        @default(now())
  attempt     UserQuizAttempt @relation(fields: [attempt_id], references: [id])
  question    Question        @relation(fields: [question_id], references: [id])
  answer      QuizzAnswer?    @relation(fields: [answer_id], references: [id])

  @@map("user_quiz_answers")
}

model Wishlist {
  user_id   Int
  course_id Int
  added_at  DateTime @default(now())
  user      User     @relation(fields: [user_id], references: [id])
  course    Course   @relation(fields: [course_id], references: [id])

  @@id([user_id, course_id]) // composite PK
  @@map("wishlists")
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
}

model Payment {
  id                      Int           @id @default(autoincrement())
  order_id                Int           @unique
  payment_method_id       String
  provider_transaction_id String
  amount                  Int
  paid_at                 DateTime      @default(now())
  paymentMethod           PaymentMethod @relation(fields: [payment_method_id], references: [id])

  @@map("payments")
}

model PaymentMethod {
  id       String    @id
  provider String
  payments Payment[]

  @@map("payment_methods")
}

enum ContentType {
  VIDEO
  ARTICLE
  QUIZ
}

model Certificate {
  user_id         Int
  course_id       Int
  issued_at       DateTime @default(now())
  certificate_url String?
  user            User     @relation(fields: [user_id], references: [id])
  course          Course   @relation(fields: [course_id], references: [id])

  @@id([user_id, course_id]) // composite PK
  @@map("certificates")
}

model UserModuleProgress {
  user_id     Int
  module_id   Int
  isCompleted Boolean
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [user_id], references: [id])
  module      Module   @relation(fields: [module_id], references: [id])

  @@id([user_id, module_id]) // composite PK
  @@map("user_module_progress")
}

model UserWallet {
  id        Int      @id @default(autoincrement())
  user_id   Int      @unique
  balance   Int      @default(0) // store currency in integer units (like cents)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [id])

  @@map("user_wallets")
}

model WalletTransaction {
  id          Int             @id @default(autoincrement())
  user_id     Int
  type        TransactionType
  amount      Int
  description String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [user_id], references: [id])

  @@map("wallet_transactions")
}

enum TransactionType {
  INFLOW
  OUTFLOW
}
